import("//ui/webui/resources/tools/build_webui.gni")

assert(!is_android)

build_webui("build") {
  grd_prefix = "ark"
  static_files = [
    "ark.css",
    "ark.html",
    "ark.svg",
  ]
  ts_files = [ "ark.ts" ]
  mojo_files_deps =
      [ "//chrome/browser/ui/webui/ark:mojo_bindings_ts__generator" ]
  mojo_files =
      [ "$root_gen_dir/chrome/browser/ui/webui/ark/ark.mojom-webui.ts" ]
  ts_deps = [ "//ui/webui/resources/mojo:build_ts" ]
  webui_context_type = "trusted"
}
